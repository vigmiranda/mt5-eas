{ RegimeRouterWDO v1.11 - Genial/Profit Pro/WDO M5
  Cascata OB>AB>OF>PB>NY>CB>IB>RD>LF>VF | lock ate flat
  v1.04: VF elegivel em R2 (mesmos criterios); OB/LF off em R2
  v1.05: Plot4(visMod) + cores das linhas
  v1.06: ConsoleLog na aba Eventos da Automacao (tipo Experts MT5)
  v1.07: OB BE+trail SL; TP avanca 1 a cada 2 subidas do SL (so OB)
  v1.08: sizing conservador por SeedCapital (<5k->1 | >=5k->2 | >=8k->3)
  v1.09: em dia R2, VF so apos 10:00 (VF_R2Start)
  v1.10: VF SL piso ATR/min risk + RR vs VWAP (anti stop curto)
  v1.11: risco/TP dinamicos por SeedCapital + BE/trail em TODOS os modulos
  Cores dos candles: use RegimeRouterWDO_viz (nao inserir ESTE como coloracao)
  Se ConsoleLog der erro de sintaxe: Profit antigo - atualize ou EnableConsoleLog=0 }
input
  SeedCapital(0.0);
  SizingByCapital(1);
  FixedLots(1);
  LotBand2Cap(5000.0);
  LotBand3Cap(8000.0);
  MaxLots(3);
  PointValueBRL(10.0);
  RiskPctPerTrade(4.0);
  RiskFracOfStop(0.80);
  DynRewardRisk(1.50);
  EnableManageTrail(1);
  Manage_BE_Pts(8);
  Manage_TrailStepPts(5);
  StopDiaPct(5.0);
  StopDiaReais(250.0);
  MaxTradesDay(12);
  FlatHora(1750);
  EnableConsoleLog(1);

  EnableOpenBreak(1);
  EnableAsiaBreak(1);
  EnableOvernightFibo(1);
  EnablePullback(1);
  EnableNYOpen(1);
  EnableContBreak(1);
  EnableInsideBreak(1);
  EnableRetestDay(1);
  EnableLunchFade(1);
  EnableVwapFade(1);

  BoxStart(900);
  BoxEnd(915);
  BoxMinPts(20);
  BoxMaxPts(120);
  OB_EntryEnd(1030);
  OB_BreakBufferPts(4);
  OB_StopPts(40);
  OB_GainPts(60);
  OB_EnableTrail(1);
  OB_BE_Pts(25);
  OB_TrailStepPts(10);
  OB_TP_MaxPts(100);

  AB_Start(915);
  AB_End(1030);
  AB_BufferPts(3);
  AB_StopPts(35);
  AB_GainPts(50);

  OF_Start(915);
  OF_End(1100);
  OF_ZoneLo(0.50);
  OF_ZoneHi(0.618);
  OF_TolPts(4);
  OF_BufferPts(5);
  OF_MinRiskPts(15);
  OF_MaxRiskPts(70);
  OF_RewardRisk(1.5);

  EMAFast(20);
  EMASlow(50);
  ADXPeriod(14);
  ADXTrendMin(20);
  EMA_SepMinPts(15);
  PB_EntryOffsetPts(2);
  PB_BufferPts(4);
  PB_MinRiskPts(20);
  PB_MaxRiskPts(100);
  PB_RewardRisk(2.0);

  NY_Start(1030);
  NY_BoxEnd(1045);
  NY_EntryEnd(1130);
  NY_BreakBufferPts(3);
  NY_FadeMinPts(20);
  NY_ADXBreak(22);
  NY_StopPts(35);
  NY_GainPts(50);

  CB_RangeEnd(1100);
  CB_ADXMin(22);
  CB_BreakBufferPts(4);
  CB_MinRiskPts(25);
  CB_MaxRiskPts(120);
  CB_RewardRisk(1.5);

  IB_Lookback(6);
  IB_ATRPeriod(14);
  IB_ATR_Compress(0.70);
  IB_BufferPts(2);
  IB_StopPts(30);
  IB_GainPts(45);
  IB_Start(1000);
  IB_End(1600);

  RD_Start(1100);
  RD_End(1600);
  RD_TolPts(5);
  RD_BufferPts(4);
  RD_MinRiskPts(15);
  RD_MaxRiskPts(70);
  RD_RewardRisk(1.8);
  RD_MinDayRangePts(25);

  LF_Start(1200);
  LF_End(1400);
  LF_MinDistPts(18);
  LF_ADXMax(20);
  LF_BufferPts(5);
  LF_MinRiskPts(12);
  LF_MaxRiskPts(55);

  VF_MinDistPts(25);
  VF_ADXMax(22);
  VF_BufferPts(6);
  VF_MinRiskPts(40);
  VF_SL_ATR_Mult(1.0);
  VF_R2_SL_ATR_Mult(1.25);
  VF_MaxRiskPts(120);
  VF_MinRewardRisk(1.0);
  VF_R2Start(1000);

var
  dayDate, lockedMod, activeMod, statusCode : Integer;
  dayStopped, r2Day, boxReady, obAborted, amReady, nyBoxReady : Integer;
  tradesToday, tradesOB, tradesAB, tradesOF, tradesPB : Integer;
  tradesNY, tradesCB, tradesIB, tradesRD, tradesLF, tradesVF : Integer;
  pbDirI : Integer;
  obBeDone, obTrailSteps, obSlMoves, wantTrail, tpAdv : Integer;
  boxH, boxL, boxPts, amH, amL, prevH, prevL : Float;
  dayH, dayL, dayOpen, nyH, nyL : Float;
  emaF, emaS, adxV, vwapV, tick, atrV, atrAvg : Float;
  entrySL, entryTP, fibLo, fibHi, mid : Float;
  dayPnL, stopLim, buf, sl, entry, risk, riskPts, distPts, rangePts : Float;
  hh, ll, obEntryPx, favorPts, extraPts, newTpPts, effCap : Float;
  floorPts, rewardPts, slStruct, atrPts : Float;
  maxRiskBRL, maxRiskPts, maxRewardPts : Float;
  visMod, lastLogTime, prevLocked, orderLots, posLots, riskArmed : Integer;

begin
  tick := MinPriceIncrement;
  if (tick <= 0) then
    tick := 0.5;

  if (Date <> dayDate) then
  begin
    if (dayH > 0) and (dayL > 0) then
    begin
      prevH := dayH;
      prevL := dayL;
    end;
    dayDate := Date;
    dayStopped := 0;
    r2Day := 0;
    boxReady := 0;
    obAborted := 0;
    amReady := 0;
    nyBoxReady := 0;
    tradesToday := 0;
    tradesOB := 0;
    tradesAB := 0;
    tradesOF := 0;
    tradesPB := 0;
    tradesNY := 0;
    tradesCB := 0;
    tradesIB := 0;
    tradesRD := 0;
    tradesLF := 0;
    tradesVF := 0;
    lockedMod := 0;
    activeMod := 0;
    statusCode := 0;
    boxH := 0;
    boxL := 0;
    boxPts := 0;
    amH := 0;
    amL := 0;
    nyH := 0;
    nyL := 0;
    dayH := 0;
    dayL := 0;
    dayOpen := 0;
    entrySL := 0;
    entryTP := 0;
    pbDirI := 0;
    lastLogTime := 0;
    prevLocked := 0;
    obBeDone := 0;
    obTrailSteps := 0;
    obSlMoves := 0;
    obEntryPx := 0;
    posLots := 0;
    orderLots := 1;
  end;

  emaF := MediaExp(EMAFast, Close);
  emaS := MediaExp(EMASlow, Close);
  adxV := ADX(ADXPeriod, 14);
  vwapV := VWAP(1);
  atrV := AvgTrueRange(IB_ATRPeriod, 0);
  atrAvg := AvgTrueRange(20, 0);

  if (dayOpen = 0) then
    dayOpen := Open;
  if (dayH = 0) then
  begin
    dayH := High;
    dayL := Low;
  end
  else
  begin
    if (High > dayH) then
      dayH := High;
    if (Low < dayL) then
      dayL := Low;
  end;

  dayPnL := DailyResult(True);
  if (SeedCapital > 0) then
    stopLim := SeedCapital * StopDiaPct / 100.0
  else
    stopLim := StopDiaReais;

  { sizing: NTSL nao le saldo da corretora — usa SeedCapital (+ dayPnL) como no WIN virtual }
  if (SizingByCapital = 0) or (SeedCapital <= 0) then
    orderLots := FixedLots
  else
  begin
    effCap := SeedCapital + dayPnL;
    orderLots := 1;
    if (effCap >= LotBand3Cap) then
      orderLots := 3
    else if (effCap >= LotBand2Cap) then
      orderLots := 2;
    if (orderLots > MaxLots) then
      orderLots := MaxLots;
    if (orderLots < 1) then
      orderLots := 1;
  end;

  { risco dinamico: max perda por trade em R$ a partir do capital (Seed) }
  if (SeedCapital > 0) then
    maxRiskBRL := SeedCapital * RiskPctPerTrade / 100.0
  else
    maxRiskBRL := Abs(stopLim) * RiskFracOfStop;
  if (maxRiskBRL > Abs(stopLim) * RiskFracOfStop) then
    maxRiskBRL := Abs(stopLim) * RiskFracOfStop;
  if (maxRiskBRL < 10) then
    maxRiskBRL := 10;
  if (PointValueBRL <= 0) then
    maxRiskPts := 999
  else
    maxRiskPts := maxRiskBRL / (PointValueBRL * orderLots);
  if (maxRiskPts < 5) then
    maxRiskPts := 5;
  maxRewardPts := maxRiskPts * DynRewardRisk;

  if (dayStopped = 0) and (dayPnL <= (0 - Abs(stopLim))) then
  begin
    dayStopped := 1;
    if HasPosition then
      ClosePosition;
    lockedMod := 0;
    activeMod := 0;
    statusCode := 11;
  end;

  if (Time >= FlatHora) then
  begin
    if HasPosition then
      ClosePosition;
    lockedMod := 0;
    activeMod := 0;
    statusCode := 12;
  end;

  if (boxReady = 0) and (Time >= BoxStart) and (Time < BoxEnd) then
  begin
    if (boxH = 0) then
    begin
      boxH := High;
      boxL := Low;
    end
    else
    begin
      if (High > boxH) then
        boxH := High;
      if (Low < boxL) then
        boxL := Low;
    end;
  end;

  if (boxReady = 0) and (Time >= BoxEnd) and (boxH > 0) then
  begin
    boxReady := 1;
    boxPts := (boxH - boxL) / tick;
    if (boxPts < BoxMinPts) or (boxPts > BoxMaxPts) then
    begin
      r2Day := 1;
      obAborted := 1;
      statusCode := 13;
    end;
  end;

  if (Time >= BoxStart) and (Time < CB_RangeEnd) then
  begin
    if (amH = 0) then
    begin
      amH := High;
      amL := Low;
    end
    else
    begin
      if (High > amH) then
        amH := High;
      if (Low < amL) then
        amL := Low;
    end;
  end;
  if (amReady = 0) and (Time >= CB_RangeEnd) and (amH > 0) then
    amReady := 1;

  if (Time >= NY_Start) and (Time < NY_BoxEnd) then
  begin
    if (nyH = 0) then
    begin
      nyH := High;
      nyL := Low;
    end
    else
    begin
      if (High > nyH) then
        nyH := High;
      if (Low < nyL) then
        nyL := Low;
    end;
  end;
  if (nyBoxReady = 0) and (Time >= NY_BoxEnd) and (nyH > 0) then
    nyBoxReady := 1;

  if (obAborted = 0) then
  begin
    if (EnableOpenBreak = 0) or (r2Day = 1) or (tradesOB > 0) then
      obAborted := 1
    else if (boxReady = 1) and (Time >= OB_EntryEnd) then
      obAborted := 1;
  end;

  {========== LOCK ==========}
  if HasPosition then
  begin
    if (lockedMod = 0) then
      lockedMod := activeMod;
    activeMod := lockedMod;

    {--- v1.11: BE + trail em TODOS os modulos (evita ficar ate FlatHora sem SL/TP) ---}
    if (lockedMod > 0) and (EnableManageTrail = 1) then
    begin
      if (obEntryPx <= 0) then
      begin
        if IsBought then
          obEntryPx := BuyPrice
        else if IsSold then
          obEntryPx := SellPrice;
      end;

      if (obEntryPx > 0) and (tick > 0) then
      begin
        if IsBought then
          favorPts := (Close - obEntryPx) / tick
        else
          favorPts := (obEntryPx - Close) / tick;

        if (obBeDone = 0) and (favorPts >= Manage_BE_Pts) then
        begin
          entrySL := obEntryPx;
          obBeDone := 1;
          obSlMoves := 1;
          if (EnableConsoleLog = 1) then
            ConsoleLog("RR ! BE mod=" + FloatToString(lockedMod, 0) + " SL@" + FloatToString(entrySL, 1) + " fav=" + FloatToString(favorPts, 0), clYellow);
        end;

        if (obBeDone = 1) and (Manage_TrailStepPts > 0) then
        begin
          extraPts := favorPts - Manage_BE_Pts;
          if (extraPts < 0) then
            extraPts := 0;
          wantTrail := extraPts / Manage_TrailStepPts;
          if (wantTrail > obTrailSteps) then
          begin
            obTrailSteps := wantTrail;
            if IsBought then
              entrySL := obEntryPx + obTrailSteps * Manage_TrailStepPts * tick
            else
              entrySL := obEntryPx - obTrailSteps * Manage_TrailStepPts * tick;
            obSlMoves := 1 + obTrailSteps;
            { OB: ainda avanca TP; demais: so trilha SL (protege lucro antes do flat) }
            if (lockedMod = 1) and (OB_EnableTrail = 1) then
            begin
              tpAdv := obSlMoves / 2;
              newTpPts := OB_GainPts + tpAdv * Manage_TrailStepPts;
              if (newTpPts > OB_TP_MaxPts) then
                newTpPts := OB_TP_MaxPts;
              if IsBought then
                entryTP := obEntryPx + newTpPts * tick
              else
                entryTP := obEntryPx - newTpPts * tick;
            end;
            if (EnableConsoleLog = 1) then
              ConsoleLog("RR ! TRAIL mod=" + FloatToString(lockedMod, 0) + " steps=" + FloatToString(obTrailSteps, 0) + " SL@" + FloatToString(entrySL, 1), clYellow);
          end;
        end;
      end;
    end;

    if IsBought then
    begin
      if (posLots <= 0) then
        posLots := orderLots;
      if (entrySL > 0) then
        SellToCoverStop(entrySL, entrySL, posLots);
      if (entryTP > 0) then
        SellToCoverLimit(entryTP, posLots);
    end
    else if IsSold then
    begin
      if (posLots <= 0) then
        posLots := orderLots;
      if (entrySL > 0) then
        BuyToCoverStop(entrySL, entrySL, posLots);
      if (entryTP > 0) then
        BuyToCoverLimit(entryTP, posLots);
    end;
  end
  else
  begin
    lockedMod := 0;
    posLots := 0;
    obBeDone := 0;
    obTrailSteps := 0;
    obSlMoves := 0;
    obEntryPx := 0;

    if (dayStopped = 1) or (Time >= FlatHora) or (boxReady = 0) then
      activeMod := 0
    else if (tradesToday >= MaxTradesDay) then
    begin
      activeMod := 0;
      statusCode := 14;
    end
    else if (EnableOpenBreak = 1) and (obAborted = 0) and (r2Day = 0) and (tradesOB = 0)
            and (Time >= BoxEnd) and (Time < OB_EntryEnd) then
    begin
      activeMod := 1;
      statusCode := 1;
      buf := OB_BreakBufferPts * tick;
      if (Close > boxH + buf) then
      begin
        entry := Close;
        entrySL := entry - OB_StopPts * tick;
        entryTP := entry + OB_GainPts * tick;
        riskPts := Abs(entry - entrySL) / tick;
        rewardPts := Abs(entry - entryTP) / tick;
        riskArmed := 0;
        if (riskPts > 0) and (riskPts <= maxRiskPts) then
        begin
          if (rewardPts > maxRewardPts) then
          begin
            entryTP := entry + maxRewardPts * tick;
            rewardPts := maxRewardPts;
          end;
          riskArmed := 1;
        end
        else if (EnableConsoleLog = 1) then
          ConsoleLog("RR .. SKIP risco " + FloatToString(riskPts, 0) + " > max " + FloatToString(maxRiskPts, 0) + " pts (cap)", clOlive);
        if (riskArmed = 1) then
        begin
          posLots := orderLots;
          obEntryPx := entry;
          obBeDone := 0;
          obTrailSteps := 0;
          obSlMoves := 0;
          BuyAtMarket(orderLots);
          tradesOB := tradesOB + 1;
          tradesToday := tradesToday + 1;
          lockedMod := 1;
          end;
      end
      else if (Close < boxL - buf) then
      begin
        entry := Close;
        entrySL := entry + OB_StopPts * tick;
        entryTP := entry - OB_GainPts * tick;
        riskPts := Abs(entry - entrySL) / tick;
        rewardPts := Abs(entry - entryTP) / tick;
        riskArmed := 0;
        if (riskPts > 0) and (riskPts <= maxRiskPts) then
        begin
          if (rewardPts > maxRewardPts) then
          begin
            entryTP := entry - maxRewardPts * tick;
            rewardPts := maxRewardPts;
          end;
          riskArmed := 1;
        end
        else if (EnableConsoleLog = 1) then
          ConsoleLog("RR .. SKIP risco " + FloatToString(riskPts, 0) + " > max " + FloatToString(maxRiskPts, 0) + " pts (cap)", clOlive);
        if (riskArmed = 1) then
        begin
          posLots := orderLots;
          obEntryPx := entry;
          obBeDone := 0;
          obTrailSteps := 0;
          obSlMoves := 0;
          SellShortAtMarket(orderLots);
          tradesOB := tradesOB + 1;
          tradesToday := tradesToday + 1;
          lockedMod := 1;
          end;
      end;
    end
    else if ((obAborted = 1) or (EnableOpenBreak = 0) or (r2Day = 1) or (tradesOB > 0))
            and (Time < FlatHora) then
    begin
      {--- 2 AB ---}
      if (EnableAsiaBreak = 1) and (tradesAB = 0) and (prevH > prevL)
         and (Time >= AB_Start) and (Time < AB_End) then
      begin
        activeMod := 2;
        statusCode := 2;
        buf := AB_BufferPts * tick;
        if (Close > prevH + buf) then
        begin
          entry := Close;
          entrySL := entry - AB_StopPts * tick;
          entryTP := entry + AB_GainPts * tick;
          riskPts := Abs(entry - entrySL) / tick;
          rewardPts := Abs(entry - entryTP) / tick;
          riskArmed := 0;
          if (riskPts > 0) and (riskPts <= maxRiskPts) then
          begin
            if (rewardPts > maxRewardPts) then
            begin
            entryTP := entry + maxRewardPts * tick;
              rewardPts := maxRewardPts;
            end;
            riskArmed := 1;
          end
          else if (EnableConsoleLog = 1) then
            ConsoleLog("RR .. SKIP risco " + FloatToString(riskPts, 0) + " > max " + FloatToString(maxRiskPts, 0) + " pts (cap)", clOlive);
          if (riskArmed = 1) then
          begin
            posLots := orderLots;
            obEntryPx := entry;
            obBeDone := 0;
            obTrailSteps := 0;
            obSlMoves := 0;
            BuyAtMarket(orderLots);
            tradesAB := tradesAB + 1;
            tradesToday := tradesToday + 1;
            lockedMod := 2;
            end;
        end
        else if (Close < prevL - buf) then
        begin
          entry := Close;
          entrySL := entry + AB_StopPts * tick;
          entryTP := entry - AB_GainPts * tick;
          riskPts := Abs(entry - entrySL) / tick;
          rewardPts := Abs(entry - entryTP) / tick;
          riskArmed := 0;
          if (riskPts > 0) and (riskPts <= maxRiskPts) then
          begin
            if (rewardPts > maxRewardPts) then
            begin
            entryTP := entry - maxRewardPts * tick;
              rewardPts := maxRewardPts;
            end;
            riskArmed := 1;
          end
          else if (EnableConsoleLog = 1) then
            ConsoleLog("RR .. SKIP risco " + FloatToString(riskPts, 0) + " > max " + FloatToString(maxRiskPts, 0) + " pts (cap)", clOlive);
          if (riskArmed = 1) then
          begin
            posLots := orderLots;
            obEntryPx := entry;
            obBeDone := 0;
            obTrailSteps := 0;
            obSlMoves := 0;
            SellShortAtMarket(orderLots);
            tradesAB := tradesAB + 1;
            tradesToday := tradesToday + 1;
            lockedMod := 2;
            end;
        end;
      end
      {--- 3 OF ---}
      else if (EnableOvernightFibo = 1) and (tradesOF = 0) and (prevH > prevL)
              and (Time >= OF_Start) and (Time < OF_End) then
      begin
        activeMod := 3;
        statusCode := 3;
        rangePts := prevH - prevL;
        fibLo := prevL + rangePts * OF_ZoneLo;
        fibHi := prevL + rangePts * OF_ZoneHi;
        mid := (prevH + prevL) / 2.0;
        buf := OF_TolPts * tick;
        if (Close <= fibHi + buf) and (Close >= fibLo - buf) then
        begin
          if (Close > mid) and (Close[1] > Open[1]) and (Close < High[1]) then
          begin
            entry := Close;
            sl := High[1] + OF_BufferPts * tick;
            risk := Abs(entry - sl);
            riskPts := risk / tick;
            if (riskPts >= OF_MinRiskPts) and (riskPts <= OF_MaxRiskPts) then
            begin
              entrySL := sl;
              entryTP := mid;
              riskPts := Abs(entry - entrySL) / tick;
              rewardPts := Abs(entry - entryTP) / tick;
              riskArmed := 0;
              if (riskPts > 0) and (riskPts <= maxRiskPts) then
              begin
                if (rewardPts > maxRewardPts) then
                begin
            entryTP := entry - maxRewardPts * tick;
                  rewardPts := maxRewardPts;
                end;
                riskArmed := 1;
              end
              else if (EnableConsoleLog = 1) then
                ConsoleLog("RR .. SKIP risco " + FloatToString(riskPts, 0) + " > max " + FloatToString(maxRiskPts, 0) + " pts (cap)", clOlive);
              if (riskArmed = 1) then
              begin
                posLots := orderLots;
                obEntryPx := entry;
                obBeDone := 0;
                obTrailSteps := 0;
                obSlMoves := 0;
                SellShortAtMarket(orderLots);
                tradesOF := tradesOF + 1;
                tradesToday := tradesToday + 1;
                lockedMod := 3;
                end;
            end;
          end
          else if (Close < mid) and (Close[1] < Open[1]) and (Close > Low[1]) then
          begin
            entry := Close;
            sl := Low[1] - OF_BufferPts * tick;
            risk := Abs(entry - sl);
            riskPts := risk / tick;
            if (riskPts >= OF_MinRiskPts) and (riskPts <= OF_MaxRiskPts) then
            begin
              entrySL := sl;
              entryTP := mid;
              riskPts := Abs(entry - entrySL) / tick;
              rewardPts := Abs(entry - entryTP) / tick;
              riskArmed := 0;
              if (riskPts > 0) and (riskPts <= maxRiskPts) then
              begin
                if (rewardPts > maxRewardPts) then
                begin
            entryTP := entry + maxRewardPts * tick;
                  rewardPts := maxRewardPts;
                end;
                riskArmed := 1;
              end
              else if (EnableConsoleLog = 1) then
                ConsoleLog("RR .. SKIP risco " + FloatToString(riskPts, 0) + " > max " + FloatToString(maxRiskPts, 0) + " pts (cap)", clOlive);
              if (riskArmed = 1) then
              begin
                posLots := orderLots;
                obEntryPx := entry;
                obBeDone := 0;
                obTrailSteps := 0;
                obSlMoves := 0;
                BuyAtMarket(orderLots);
                tradesOF := tradesOF + 1;
                tradesToday := tradesToday + 1;
                lockedMod := 3;
                end;
            end;
          end;
        end;
      end
      {--- 4 PB ---}
      else if (EnablePullback = 1) and (tradesPB = 0) and (adxV >= ADXTrendMin)
              and (Abs(emaF - emaS) / tick >= EMA_SepMinPts) then
      begin
        pbDirI := 0;
        if (emaF > emaS) and (Close > emaF) and (Low[1] <= emaF[1]) and (Close[1] > emaF[1]) and (Close[1] > Open[1]) then
          pbDirI := 1;
        if (emaF < emaS) and (Close < emaF) and (High[1] >= emaF[1]) and (Close[1] < emaF[1]) and (Close[1] < Open[1]) then
          pbDirI := -1;
        if (pbDirI <> 0) then
        begin
          activeMod := 4;
          statusCode := 4;
