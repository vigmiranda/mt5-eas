{ RegimeRouterWDO v1.04 — Genial/Profit Pro/WDO M5
  Cascata OB>AB>OF>PB>NY>CB>IB>RD>LF>VF | lock ate flat
  v1.04: VF elegivel em R2 (mesmos criterios dist/ADX); OB off em R2
  LF continua bloqueado em R2 (janela especifica). Automacao em M5. }
input
  SeedCapital(0.0);
  StopDiaPct(5.0);
  StopDiaReais(250.0);
  MaxTradesDay(12);
  FlatHora(1750);

  EnableOpenBreak(1);
  EnableAsiaBreak(1);
  EnableOvernightFibo(1);
  EnablePullback(1);
  EnableNYOpen(1);
  EnableContBreak(1);
  EnableInsideBreak(1);
  EnableRetestDay(1);
  EnableLunchFade(1);
  EnableVwapFade(1);

  BoxStart(900);
  BoxEnd(915);
  BoxMinPts(20);
  BoxMaxPts(120);
  OB_EntryEnd(1030);
  OB_BreakBufferPts(4);
  OB_StopPts(40);
  OB_GainPts(60);

  AB_Start(915);
  AB_End(1030);
  AB_BufferPts(3);
  AB_StopPts(35);
  AB_GainPts(50);

  OF_Start(915);
  OF_End(1100);
  OF_ZoneLo(0.50);
  OF_ZoneHi(0.618);
  OF_TolPts(4);
  OF_BufferPts(5);
  OF_MinRiskPts(15);
  OF_MaxRiskPts(70);
  OF_RewardRisk(1.5);

  EMAFast(20);
  EMASlow(50);
  ADXPeriod(14);
  ADXTrendMin(20);
  EMA_SepMinPts(15);
  PB_EntryOffsetPts(2);
  PB_BufferPts(4);
  PB_MinRiskPts(20);
  PB_MaxRiskPts(100);
  PB_RewardRisk(2.0);

  NY_Start(1030);
  NY_BoxEnd(1045);
  NY_EntryEnd(1130);
  NY_BreakBufferPts(3);
  NY_FadeMinPts(20);
  NY_ADXBreak(22);
  NY_StopPts(35);
  NY_GainPts(50);

  CB_RangeEnd(1100);
  CB_ADXMin(22);
  CB_BreakBufferPts(4);
  CB_MinRiskPts(25);
  CB_MaxRiskPts(120);
  CB_RewardRisk(1.5);

  IB_Lookback(6);
  IB_ATRPeriod(14);
  IB_ATR_Compress(0.70);
  IB_BufferPts(2);
  IB_StopPts(30);
  IB_GainPts(45);
  IB_Start(1000);
  IB_End(1600);

  RD_Start(1100);
  RD_End(1600);
  RD_TolPts(5);
  RD_BufferPts(4);
  RD_MinRiskPts(15);
  RD_MaxRiskPts(70);
  RD_RewardRisk(1.8);
  RD_MinDayRangePts(25);

  LF_Start(1200);
  LF_End(1400);
  LF_MinDistPts(18);
  LF_ADXMax(20);
  LF_BufferPts(5);
  LF_MinRiskPts(12);
  LF_MaxRiskPts(55);

  VF_MinDistPts(25);
  VF_ADXMax(22);
  VF_BufferPts(6);
  VF_MinRiskPts(15);
  VF_MaxRiskPts(80);

var
  dayDate, lockedMod, activeMod, statusCode : Integer;
  dayStopped, r2Day, boxReady, obAborted, amReady, nyBoxReady : Integer;
  tradesToday, tradesOB, tradesAB, tradesOF, tradesPB : Integer;
  tradesNY, tradesCB, tradesIB, tradesRD, tradesLF, tradesVF : Integer;
  pbDirI : Integer;
  boxH, boxL, boxPts, amH, amL, prevH, prevL : Float;
  dayH, dayL, dayOpen, nyH, nyL : Float;
  emaF, emaS, adxV, vwapV, tick, atrV, atrAvg : Float;
  entrySL, entryTP, fibLo, fibHi, mid : Float;
  dayPnL, stopLim, buf, sl, entry, risk, riskPts, distPts, rangePts : Float;
  hh, ll : Float;

begin
  tick := MinPriceIncrement;
  if (tick <= 0) then
    tick := 0.5;

  if (Date <> dayDate) then
  begin
    if (dayH > 0) and (dayL > 0) then
    begin
      prevH := dayH;
      prevL := dayL;
    end;
    dayDate := Date;
    dayStopped := 0;
    r2Day := 0;
    boxReady := 0;
    obAborted := 0;
    amReady := 0;
    nyBoxReady := 0;
    tradesToday := 0;
    tradesOB := 0;
    tradesAB := 0;
    tradesOF := 0;
    tradesPB := 0;
    tradesNY := 0;
    tradesCB := 0;
    tradesIB := 0;
    tradesRD := 0;
    tradesLF := 0;
    tradesVF := 0;
    lockedMod := 0;
    activeMod := 0;
    statusCode := 0;
    boxH := 0;
    boxL := 0;
    boxPts := 0;
    amH := 0;
    amL := 0;
    nyH := 0;
    nyL := 0;
    dayH := 0;
    dayL := 0;
    dayOpen := 0;
    entrySL := 0;
    entryTP := 0;
    pbDirI := 0;
  end;

  emaF := MediaExp(EMAFast, Close);
  emaS := MediaExp(EMASlow, Close);
  adxV := ADX(ADXPeriod, 14);
  vwapV := VWAP(1);
  atrV := AvgTrueRange(IB_ATRPeriod, 0);
  atrAvg := AvgTrueRange(20, 0);

  if (dayOpen = 0) then
    dayOpen := Open;
  if (dayH = 0) then
  begin
    dayH := High;
    dayL := Low;
  end
  else
  begin
    if (High > dayH) then
      dayH := High;
    if (Low < dayL) then
      dayL := Low;
  end;

  dayPnL := DailyResult(True);
  if (SeedCapital > 0) then
    stopLim := SeedCapital * StopDiaPct / 100.0
  else
    stopLim := StopDiaReais;

  if (dayStopped = 0) and (dayPnL <= (0 - Abs(stopLim))) then
  begin
    dayStopped := 1;
    if HasPosition then
      ClosePosition;
    lockedMod := 0;
    activeMod := 0;
    statusCode := 11;
  end;

  if (Time >= FlatHora) then
  begin
    if HasPosition then
      ClosePosition;
    lockedMod := 0;
    activeMod := 0;
    statusCode := 12;
  end;

  if (boxReady = 0) and (Time >= BoxStart) and (Time < BoxEnd) then
  begin
    if (boxH = 0) then
    begin
      boxH := High;
      boxL := Low;
    end
    else
    begin
      if (High > boxH) then
        boxH := High;
      if (Low < boxL) then
        boxL := Low;
    end;
  end;

  if (boxReady = 0) and (Time >= BoxEnd) and (boxH > 0) then
  begin
    boxReady := 1;
    boxPts := (boxH - boxL) / tick;
    if (boxPts < BoxMinPts) or (boxPts > BoxMaxPts) then
    begin
      r2Day := 1;
      obAborted := 1;
      statusCode := 13;
    end;
  end;

  if (Time >= BoxStart) and (Time < CB_RangeEnd) then
  begin
    if (amH = 0) then
    begin
      amH := High;
      amL := Low;
    end
    else
    begin
      if (High > amH) then
        amH := High;
      if (Low < amL) then
        amL := Low;
    end;
  end;
  if (amReady = 0) and (Time >= CB_RangeEnd) and (amH > 0) then
    amReady := 1;

  if (Time >= NY_Start) and (Time < NY_BoxEnd) then
  begin
    if (nyH = 0) then
    begin
      nyH := High;
      nyL := Low;
    end
    else
    begin
      if (High > nyH) then
        nyH := High;
      if (Low < nyL) then
        nyL := Low;
    end;
  end;
  if (nyBoxReady = 0) and (Time >= NY_BoxEnd) and (nyH > 0) then
    nyBoxReady := 1;

  if (obAborted = 0) then
  begin
    if (EnableOpenBreak = 0) or (r2Day = 1) or (tradesOB > 0) then
      obAborted := 1
    else if (boxReady = 1) and (Time >= OB_EntryEnd) then
      obAborted := 1;
  end;

  {========== LOCK ==========}
  if HasPosition then
  begin
    if (lockedMod = 0) then
      lockedMod := activeMod;
    activeMod := lockedMod;
    if IsBought then
    begin
      if (entrySL > 0) then
        SellToCoverStop(entrySL, entrySL);
      if (entryTP > 0) then
        SellToCoverLimit(entryTP);
    end
    else if IsSold then
    begin
      if (entrySL > 0) then
        BuyToCoverStop(entrySL, entrySL);
      if (entryTP > 0) then
        BuyToCoverLimit(entryTP);
    end;
  end
  else
  begin
    lockedMod := 0;

    if (dayStopped = 1) or (Time >= FlatHora) or (boxReady = 0) then
      activeMod := 0
    else if (tradesToday >= MaxTradesDay) then
    begin
      activeMod := 0;
      statusCode := 14;
    end
    else if (EnableOpenBreak = 1) and (obAborted = 0) and (r2Day = 0) and (tradesOB = 0)
            and (Time >= BoxEnd) and (Time < OB_EntryEnd) then
    begin
      activeMod := 1;
      statusCode := 1;
      buf := OB_BreakBufferPts * tick;
      if (Close > boxH + buf) then
      begin
        entry := Close;
        entrySL := entry - OB_StopPts * tick;
        entryTP := entry + OB_GainPts * tick;
        BuyAtMarket;
        tradesOB := tradesOB + 1;
        tradesToday := tradesToday + 1;
        lockedMod := 1;
      end
      else if (Close < boxL - buf) then
      begin
        entry := Close;
        entrySL := entry + OB_StopPts * tick;
        entryTP := entry - OB_GainPts * tick;
        SellShortAtMarket;
        tradesOB := tradesOB + 1;
        tradesToday := tradesToday + 1;
        lockedMod := 1;
      end;
    end
    else if ((obAborted = 1) or (EnableOpenBreak = 0) or (r2Day = 1) or (tradesOB > 0))
            and (Time < FlatHora) then
    begin
      {--- 2 AB ---}
      if (EnableAsiaBreak = 1) and (tradesAB = 0) and (prevH > prevL)
         and (Time >= AB_Start) and (Time < AB_End) then
      begin
        activeMod := 2;
        statusCode := 2;
        buf := AB_BufferPts * tick;
        if (Close > prevH + buf) then
        begin
          entry := Close;
          entrySL := entry - AB_StopPts * tick;
          entryTP := entry + AB_GainPts * tick;
          BuyAtMarket;
          tradesAB := tradesAB + 1;
          tradesToday := tradesToday + 1;
          lockedMod := 2;
        end
        else if (Close < prevL - buf) then
        begin
          entry := Close;
          entrySL := entry + AB_StopPts * tick;
          entryTP := entry - AB_GainPts * tick;
          SellShortAtMarket;
          tradesAB := tradesAB + 1;
          tradesToday := tradesToday + 1;
          lockedMod := 2;
        end;
      end
      {--- 3 OF ---}
      else if (EnableOvernightFibo = 1) and (tradesOF = 0) and (prevH > prevL)
              and (Time >= OF_Start) and (Time < OF_End) then
      begin
        activeMod := 3;
        statusCode := 3;
        rangePts := prevH - prevL;
        fibLo := prevL + rangePts * OF_ZoneLo;
        fibHi := prevL + rangePts * OF_ZoneHi;
        mid := (prevH + prevL) / 2.0;
        buf := OF_TolPts * tick;
        if (Close <= fibHi + buf) and (Close >= fibLo - buf) then
        begin
          if (Close > mid) and (Close[1] > Open[1]) and (Close < High[1]) then
          begin
            entry := Close;
            sl := High[1] + OF_BufferPts * tick;
            risk := Abs(entry - sl);
            riskPts := risk / tick;
            if (riskPts >= OF_MinRiskPts) and (riskPts <= OF_MaxRiskPts) then
            begin
              entrySL := sl;
              entryTP := mid;
              SellShortAtMarket;
              tradesOF := tradesOF + 1;
              tradesToday := tradesToday + 1;
              lockedMod := 3;
            end;
          end
          else if (Close < mid) and (Close[1] < Open[1]) and (Close > Low[1]) then
          begin
            entry := Close;
            sl := Low[1] - OF_BufferPts * tick;
            risk := Abs(entry - sl);
            riskPts := risk / tick;
            if (riskPts >= OF_MinRiskPts) and (riskPts <= OF_MaxRiskPts) then
            begin
              entrySL := sl;
              entryTP := mid;
              BuyAtMarket;
              tradesOF := tradesOF + 1;
              tradesToday := tradesToday + 1;
              lockedMod := 3;
            end;
          end;
        end;
      end
      {--- 4 PB ---}
      else if (EnablePullback = 1) and (tradesPB = 0) and (adxV >= ADXTrendMin)
              and (Abs(emaF - emaS) / tick >= EMA_SepMinPts) then
      begin
        pbDirI := 0;
        if (emaF > emaS) and (Close > emaF) and (Low[1] <= emaF[1]) and (Close[1] > emaF[1]) and (Close[1] > Open[1]) then
          pbDirI := 1;
        if (emaF < emaS) and (Close < emaF) and (High[1] >= emaF[1]) and (Close[1] < emaF[1]) and (Close[1] < Open[1]) then
          pbDirI := -1;
        if (pbDirI <> 0) then
        begin
          activeMod := 4;
          statusCode := 4;
          buf := PB_EntryOffsetPts * tick;
          if (pbDirI = 1) and (Close >= High[1] + buf) then
          begin
            entry := Close;
            sl := Low[1] - PB_BufferPts * tick;
            risk := Abs(entry - sl);
            riskPts := risk / tick;
            if (riskPts >= PB_MinRiskPts) and (riskPts <= PB_MaxRiskPts) then
            begin
              entrySL := sl;
              entryTP := entry + PB_RewardRisk * risk;
              BuyAtMarket;
              tradesPB := tradesPB + 1;
              tradesToday := tradesToday + 1;
              lockedMod := 4;
            end;
          end
          else if (pbDirI = -1) and (Close <= Low[1] - buf) then
          begin
            entry := Close;
            sl := High[1] + PB_BufferPts * tick;
            risk := Abs(entry - sl);
            riskPts := risk / tick;
            if (riskPts >= PB_MinRiskPts) and (riskPts <= PB_MaxRiskPts) then
            begin
              entrySL := sl;
              entryTP := entry - PB_RewardRisk * risk;
              SellShortAtMarket;
              tradesPB := tradesPB + 1;
              tradesToday := tradesToday + 1;
              lockedMod := 4;
            end;
          end;
        end
        else
          activeMod := 0;
      end
      {--- 5 NY ---}
      else if (EnableNYOpen = 1) and (tradesNY = 0) and (nyBoxReady = 1)
              and (Time >= NY_BoxEnd) and (Time < NY_EntryEnd) then
      begin
        activeMod := 5;
        statusCode := 5;
        buf := NY_BreakBufferPts * tick;
        mid := (nyH + nyL) / 2.0;
        distPts := Abs(Close - mid) / tick;
        if (adxV >= NY_ADXBreak) and (Close > nyH + buf) then
        begin
          entry := Close;
          entrySL := entry - NY_StopPts * tick;
          entryTP := entry + NY_GainPts * tick;
          BuyAtMarket;
          tradesNY := tradesNY + 1;
          tradesToday := tradesToday + 1;
          lockedMod := 5;
        end
        else if (adxV >= NY_ADXBreak) and (Close < nyL - buf) then
        begin
          entry := Close;
          entrySL := entry + NY_StopPts * tick;
          entryTP := entry - NY_GainPts * tick;
          SellShortAtMarket;
          tradesNY := tradesNY + 1;
          tradesToday := tradesToday + 1;
          lockedMod := 5;
        end
        else if (adxV < NY_ADXBreak) and (distPts >= NY_FadeMinPts) then
        begin
          if (Close > nyH) then
          begin
            entry := Close;
            sl := High[1] + 3 * tick;
            risk := Abs(entry - sl);
            riskPts := risk / tick;
            if (riskPts >= 12) and (riskPts <= 60) then
            begin
              entrySL := sl;
              entryTP := mid;
              SellShortAtMarket;
              tradesNY := tradesNY + 1;
              tradesToday := tradesToday + 1;
              lockedMod := 5;
            end;
          end
          else if (Close < nyL) then
          begin
            entry := Close;
            sl := Low[1] - 3 * tick;
            risk := Abs(entry - sl);
            riskPts := risk / tick;
            if (riskPts >= 12) and (riskPts <= 60) then
            begin
              entrySL := sl;
              entryTP := mid;
              BuyAtMarket;
              tradesNY := tradesNY + 1;
              tradesToday := tradesToday + 1;
              lockedMod := 5;
            end;
          end;
        end;
      end
      {--- 6 CB ---}
      else if (EnableContBreak = 1) and (tradesCB = 0) and (amReady = 1)
              and (adxV >= CB_ADXMin) and (Abs(emaF - emaS) / tick >= EMA_SepMinPts) then
      begin
        activeMod := 6;
        statusCode := 6;
        buf := CB_BreakBufferPts * tick;
        if (emaF > emaS) and (Close > emaF) and (Close > amH + buf) then
        begin
          entry := Close;
          sl := amL - CB_BreakBufferPts * tick;
          risk := Abs(entry - sl);
          riskPts := risk / tick;
          if (riskPts >= CB_MinRiskPts) and (riskPts <= CB_MaxRiskPts) then
          begin
            entrySL := sl;
            entryTP := entry + CB_RewardRisk * risk;
            BuyAtMarket;
            tradesCB := tradesCB + 1;
            tradesToday := tradesToday + 1;
            lockedMod := 6;
          end;
        end
        else if (emaF < emaS) and (Close < emaF) and (Close < amL - buf) then
        begin
          entry := Close;
          sl := amH + CB_BreakBufferPts * tick;
          risk := Abs(entry - sl);
          riskPts := risk / tick;
          if (riskPts >= CB_MinRiskPts) and (riskPts <= CB_MaxRiskPts) then
          begin
            entrySL := sl;
            entryTP := entry - CB_RewardRisk * risk;
            SellShortAtMarket;
            tradesCB := tradesCB + 1;
            tradesToday := tradesToday + 1;
            lockedMod := 6;
          end;
        end;
      end
      {--- 7 IB ---}
      else if (EnableInsideBreak = 1) and (tradesIB = 0)
              and (atrAvg > 0) and (atrV < atrAvg * IB_ATR_Compress)
              and (Time >= IB_Start) and (Time < IB_End) then
      begin
        activeMod := 7;
        statusCode := 7;
        buf := IB_BufferPts * tick;
        hh := Highest(High, IB_Lookback);
        ll := Lowest(Low, IB_Lookback);
        if (Close > hh + buf) then
        begin
          entry := Close;
          entrySL := entry - IB_StopPts * tick;
          entryTP := entry + IB_GainPts * tick;
          BuyAtMarket;
          tradesIB := tradesIB + 1;
          tradesToday := tradesToday + 1;
          lockedMod := 7;
        end
        else if (Close < ll - buf) then
        begin
          entry := Close;
          entrySL := entry + IB_StopPts * tick;
          entryTP := entry - IB_GainPts * tick;
          SellShortAtMarket;
          tradesIB := tradesIB + 1;
          tradesToday := tradesToday + 1;
          lockedMod := 7;
        end;
      end
      {--- 8 RD ---}
      else if (EnableRetestDay = 1) and (tradesRD = 0)
              and (Time >= RD_Start) and (Time < RD_End)
              and ((dayH - dayL) / tick >= RD_MinDayRangePts) then
      begin
        activeMod := 8;
        statusCode := 8;
        buf := RD_TolPts * tick;
        if (Abs(Close - dayOpen) <= buf) then
        begin
          if (Close[1] < Open[1]) and (emaF > emaS) and (Close > emaF) then
          begin
            entry := Close;
            sl := Low[1] - RD_BufferPts * tick;
            risk := Abs(entry - sl);
            riskPts := risk / tick;
            if (riskPts >= RD_MinRiskPts) and (riskPts <= RD_MaxRiskPts) then
            begin
              entrySL := sl;
              entryTP := entry + RD_RewardRisk * risk;
              BuyAtMarket;
              tradesRD := tradesRD + 1;
              tradesToday := tradesToday + 1;
              lockedMod := 8;
            end;
          end
          else if (Close[1] > Open[1]) and (emaF < emaS) and (Close < emaF) then
          begin
            entry := Close;
            sl := High[1] + RD_BufferPts * tick;
            risk := Abs(entry - sl);
            riskPts := risk / tick;
            if (riskPts >= RD_MinRiskPts) and (riskPts <= RD_MaxRiskPts) then
            begin
              entrySL := sl;
              entryTP := entry - RD_RewardRisk * risk;
              SellShortAtMarket;
              tradesRD := tradesRD + 1;
              tradesToday := tradesToday + 1;
              lockedMod := 8;
            end;
          end;
        end
        else if (emaF > emaS) and (Close > emaF) and (Abs(Low - dayL) <= buf) and (Close > Open) then
        begin
          entry := Close;
          sl := dayL - RD_BufferPts * tick;
          risk := Abs(entry - sl);
          riskPts := risk / tick;
          if (riskPts >= RD_MinRiskPts) and (riskPts <= RD_MaxRiskPts) then
          begin
            entrySL := sl;
            entryTP := entry + RD_RewardRisk * risk;
            BuyAtMarket;
            tradesRD := tradesRD + 1;
            tradesToday := tradesToday + 1;
            lockedMod := 8;
          end;
        end
        else if (emaF < emaS) and (Close < emaF) and (Abs(High - dayH) <= buf) and (Close < Open) then
        begin
          entry := Close;
          sl := dayH + RD_BufferPts * tick;
          risk := Abs(entry - sl);
          riskPts := risk / tick;
          if (riskPts >= RD_MinRiskPts) and (riskPts <= RD_MaxRiskPts) then
          begin
            entrySL := sl;
            entryTP := entry - RD_RewardRisk * risk;
            SellShortAtMarket;
            tradesRD := tradesRD + 1;
            tradesToday := tradesToday + 1;
            lockedMod := 8;
          end;
        end;
      end
      {--- 9 LF ---}
      else if (EnableLunchFade = 1) and (tradesLF = 0) and (r2Day = 0)
              and (Time >= LF_Start) and (Time < LF_End) and (adxV <= LF_ADXMax) then
      begin
        distPts := Abs(Close - vwapV) / tick;
        if (distPts >= LF_MinDistPts) then
        begin
          activeMod := 9;
          statusCode := 9;
          buf := LF_BufferPts * tick;
          if (Close > vwapV) then
          begin
            entry := Close;
            sl := High[1] + buf;
            risk := Abs(entry - sl);
            riskPts := risk / tick;
            if (riskPts >= LF_MinRiskPts) and (riskPts <= LF_MaxRiskPts) and (vwapV < entry) then
            begin
              entrySL := sl;
              entryTP := vwapV;
              SellShortAtMarket;
              tradesLF := tradesLF + 1;
              tradesToday := tradesToday + 1;
              lockedMod := 9;
            end;
          end
          else
          begin
            entry := Close;
            sl := Low[1] - buf;
            risk := Abs(entry - sl);
            riskPts := risk / tick;
            if (riskPts >= LF_MinRiskPts) and (riskPts <= LF_MaxRiskPts) and (vwapV > entry) then
            begin
              entrySL := sl;
              entryTP := vwapV;
              BuyAtMarket;
              tradesLF := tradesLF + 1;
              tradesToday := tradesToday + 1;
              lockedMod := 9;
            end;
          end;
        end
        else
          activeMod := 0;
      end
      {--- 10 VF (tambem em R2; criterios dist/ADX iguais) ---}
      else if (EnableVwapFade = 1) and (tradesVF = 0) and (adxV <= VF_ADXMax) then
      begin
        distPts := Abs(Close - vwapV) / tick;
        if (distPts >= VF_MinDistPts) then
        begin
          activeMod := 10;
          statusCode := 10;
          buf := VF_BufferPts * tick;
          if (Close > vwapV) then
          begin
            entry := Close;
            sl := High[1] + buf;
            risk := Abs(entry - sl);
            riskPts := risk / tick;
            if (riskPts >= VF_MinRiskPts) and (riskPts <= VF_MaxRiskPts) and (vwapV < entry) then
            begin
              entrySL := sl;
              entryTP := vwapV;
              SellShortAtMarket;
              tradesVF := tradesVF + 1;
              tradesToday := tradesToday + 1;
              lockedMod := 10;
            end;
          end
          else
          begin
            entry := Close;
            sl := Low[1] - buf;
            risk := Abs(entry - sl);
            riskPts := risk / tick;
            if (riskPts >= VF_MinRiskPts) and (riskPts <= VF_MaxRiskPts) and (vwapV > entry) then
            begin
              entrySL := sl;
              entryTP := vwapV;
              BuyAtMarket;
              tradesVF := tradesVF + 1;
              tradesToday := tradesToday + 1;
              lockedMod := 10;
            end;
          end;
        end
        else
        begin
          activeMod := 0;
          statusCode := 0;
        end;
      end
      else
      begin
        activeMod := 0;
        if (r2Day = 1) then
          statusCode := 13
        else
          statusCode := 0;
      end;
    end
    else
    begin
      activeMod := 0;
      statusCode := 1;
    end;
  end;

  Plot(emaF);
  Plot2(emaS);
  Plot3(vwapV);

end;
