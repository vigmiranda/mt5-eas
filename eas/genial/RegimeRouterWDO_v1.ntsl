        if (distPts >= VF_MinDistPts) then
        begin
          activeMod := 10;
          statusCode := 10;
          buf := VF_BufferPts * tick;
          atrPts := atrV / tick;
          if (r2Day = 1) then
            floorPts := Max(VF_MinRiskPts, atrPts * VF_R2_SL_ATR_Mult)
          else
            floorPts := Max(VF_MinRiskPts, atrPts * VF_SL_ATR_Mult);
          if (Close > vwapV) then
          begin
            entry := Close;
            slStruct := High[1] + buf;
            sl := Max(slStruct, entry + floorPts * tick);
            risk := Abs(entry - sl);
            riskPts := risk / tick;
            rewardPts := Abs(entry - vwapV) / tick;
            if (riskPts >= floorPts) and (riskPts <= VF_MaxRiskPts)
               and (vwapV < entry) and (rewardPts >= riskPts * VF_MinRewardRisk) then
            begin
              entrySL := sl;
              entryTP := vwapV;
              riskPts := Abs(entry - entrySL) / tick;
              rewardPts := Abs(entry - entryTP) / tick;
              riskArmed := 0;
              if (riskPts > 0) and (riskPts <= maxRiskPts) then
              begin
                if (rewardPts > maxRewardPts) then
                begin
            entryTP := entry - maxRewardPts * tick;
                  rewardPts := maxRewardPts;
                end;
                riskArmed := 1;
              end
              else if (EnableConsoleLog = 1) then
                ConsoleLog("RR .. SKIP risco " + FloatToString(riskPts, 0) + " > max " + FloatToString(maxRiskPts, 0) + " pts (cap)", clOlive);
              if (riskArmed = 1) then
              begin
                posLots := orderLots;
                obEntryPx := entry;
                obBeDone := 0;
                obTrailSteps := 0;
                obSlMoves := 0;
                SellShortAtMarket(orderLots);
                tradesVF := tradesVF + 1;
                tradesToday := tradesToday + 1;
                lockedMod := 10;
                end;
            end;
          end
          else
          begin
            entry := Close;
            slStruct := Low[1] - buf;
            sl := Min(slStruct, entry - floorPts * tick);
            risk := Abs(entry - sl);
            riskPts := risk / tick;
            rewardPts := Abs(entry - vwapV) / tick;
            if (riskPts >= floorPts) and (riskPts <= VF_MaxRiskPts)
               and (vwapV > entry) and (rewardPts >= riskPts * VF_MinRewardRisk) then
            begin
              entrySL := sl;
              entryTP := vwapV;
              riskPts := Abs(entry - entrySL) / tick;
              rewardPts := Abs(entry - entryTP) / tick;
              riskArmed := 0;
              if (riskPts > 0) and (riskPts <= maxRiskPts) then
              begin
                if (rewardPts > maxRewardPts) then
                begin
            entryTP := entry + maxRewardPts * tick;
                  rewardPts := maxRewardPts;
                end;
                riskArmed := 1;
              end
              else if (EnableConsoleLog = 1) then
                ConsoleLog("RR .. SKIP risco " + FloatToString(riskPts, 0) + " > max " + FloatToString(maxRiskPts, 0) + " pts (cap)", clOlive);
              if (riskArmed = 1) then
              begin
                posLots := orderLots;
                obEntryPx := entry;
                obBeDone := 0;
                obTrailSteps := 0;
                obSlMoves := 0;
                BuyAtMarket(orderLots);
                tradesVF := tradesVF + 1;
                tradesToday := tradesToday + 1;
                lockedMod := 10;
                end;
            end;
          end;
        end
        else
        begin
          activeMod := 0;
          statusCode := 0;
        end;
      end
      else
      begin
        activeMod := 0;
        if (r2Day = 1) then
          statusCode := 13
        else
          statusCode := 0;
      end;
    end
    else
    begin
      activeMod := 0;
      statusCode := 1;
    end;
  end;

  {--- visual: modulo ativo/lock (subplot Plot4) - ver RegimeRouterWDO_LOG.md ---}
  visMod := lockedMod;
  if (visMod = 0) then
    visMod := activeMod;
  if (statusCode = 11) then
    visMod := 11
  else if (statusCode = 12) then
    visMod := 12
  else if (statusCode = 13) and (visMod = 0) then
    visMod := 13
  else if (statusCode = 14) then
    visMod := 14;

  Plot(emaF);
  Plot2(emaS);
  Plot3(vwapV);
  Plot4(visMod);
  SetPlotColor(1, clYellow);
  SetPlotColor(2, clBlue);
  SetPlotColor(3, clWhite);
  SetPlotColor(4, clLime);

  {--- ConsoleLog -> aba Eventos da Automacao (equiv. Experts MT5) ---}
  if (EnableConsoleLog = 1) then
  begin
    if (lockedMod > 0) and (lockedMod <> prevLocked) then
    begin
      ConsoleLog("RR ! ENTRADA mod=" + FloatToString(lockedMod, 0) + " vol=" + FloatToString(posLots, 0) + " st=" + FloatToString(statusCode, 0) + " cx=" + FloatToString(boxPts, 0) + " ADX=" + FloatToString(adxV, 0) + " dPnL=" + FloatToString(dayPnL, 0), clLime);
      prevLocked := lockedMod;
    end;
    if (lockedMod = 0) then
      prevLocked := 0;
    if (Time <> lastLogTime) then
    begin
      lastLogTime := Time;
      if (statusCode = 11) then
        ConsoleLog("RR " + FloatToString(Time, 0) + " | STOP | dPnL=" + FloatToString(dayPnL, 0) + " lim=" + FloatToString(stopLim, 0), clRed)
      else if (visMod = 13) or ((r2Day = 1) and (lockedMod = 0) and (activeMod = 0)) then
        ConsoleLog("RR " + FloatToString(Time, 0) + " | R2 IDLE | cx=" + FloatToString(boxPts, 0) + " ADX=" + FloatToString(adxV, 0) + " dPnL=" + FloatToString(dayPnL, 0) + " t=" + FloatToString(tradesToday, 0), clOlive)
      else if (lockedMod > 0) then
        ConsoleLog("RR " + FloatToString(Time, 0) + " | LOCK mod=" + FloatToString(lockedMod, 0) + " | cx=" + FloatToString(boxPts, 0) + " ADX=" + FloatToString(adxV, 0) + " dPnL=" + FloatToString(dayPnL, 0), clAqua)
      else
        ConsoleLog("RR " + FloatToString(Time, 0) + " | mod=" + FloatToString(activeMod, 0) + " st=" + FloatToString(statusCode, 0) + " | cx=" + FloatToString(boxPts, 0) + " ADX=" + FloatToString(adxV, 0) + " R2=" + FloatToString(r2Day, 0) + " t=" + FloatToString(tradesToday, 0) + " vol=" + FloatToString(orderLots, 0) + " riskMax=" + FloatToString(maxRiskPts, 0) + " dPnL=" + FloatToString(dayPnL, 0), clWhite);
    end;
  end;

end;
